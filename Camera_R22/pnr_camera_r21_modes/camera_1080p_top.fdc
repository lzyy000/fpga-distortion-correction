define_attribute {n:ov1_pclk} {PAP_CLOCK_DEDICATED_ROUTE} {FALSE}
# The IO delay renames the existing ordinary-pin clock net during mapping.
# Keep the original general-route allowance on its alias; timing remains checked.
# Provisional external timing envelope: v7 launch reference is rising PCLK;
# max 4ns / min 0.5ns incl. connector skew. Requires scope measurement on actual board.
set_input_delay -clock [get_clocks ov1_pclk] -max 4.000 [get_ports {ov1_data[*] ov1_href ov1_vsync}]
set_input_delay -clock [get_clocks ov1_pclk] -min 0.500 [get_ports {ov1_data[*] ov1_href ov1_vsync}]
set_clock_uncertainty 0.300 [get_clocks ov1_pclk]
set_false_path -from [get_ports {ov1_scl ov1_sda}]
set_false_path -to [get_ports {ov1_scl ov1_sda ov1_resetn ov1_pwdn ov2_resetn ov2_pwdn}]
set_max_delay -datapath_only 5.952 -from [get_cells -hierarchical {capture*frame_gray*}] -to [get_cells -hierarchical {fg1*}]


# Request input-register placement at IO; keep all external timing checks.
define_attribute {p:ov1_data[0]} {syn_useioff} {1}
define_attribute {p:ov1_data[1]} {syn_useioff} {1}
define_attribute {p:ov1_data[2]} {syn_useioff} {1}
define_attribute {p:ov1_data[3]} {syn_useioff} {1}
define_attribute {p:ov1_data[4]} {syn_useioff} {1}
define_attribute {p:ov1_data[5]} {syn_useioff} {1}
define_attribute {p:ov1_data[6]} {syn_useioff} {1}
define_attribute {p:ov1_data[7]} {syn_useioff} {1}
define_attribute {p:ov1_href} {syn_useioff} {1}
define_attribute {p:ov1_vsync} {syn_useioff} {1}

# Passive monitor: Gray counters and non-control snapshots cross into core clock.
set_max_delay -datapath_only 5.952 -from [get_cells -hierarchical {dvp_monitor*tg* dvp_monitor*vg* dvp_monitor*hg*}] -to [get_cells -hierarchical {dvp_monitor*t1* dvp_monitor*v1* dvp_monitor*h1*}]
set_false_path -from [get_clocks ov1_pclk] -to [get_cells -hierarchical {dvp_monitor*w1* dvp_monitor*l1*}]

# Independent raw-pin monitor: only the first metastability stage is asynchronous.
set_false_path -from [get_ports {ov1_href ov1_vsync}] -to [get_cells -hierarchical {pin_monitor*href_meta* pin_monitor*vs_meta*}]
set_false_path -from [get_ports {key_n[3]}] -to [get_cells -hierarchical {hdmi_output*force_meta*}]

# Qualified-control diagnostics: Gray event counters and held first-fault snapshot.
set_max_delay -datapath_only 5.952 -from [get_cells -hierarchical {input_qualifier*vs_glitch_gray* input_qualifier*href_glitch_gray*}] -to [get_cells -hierarchical {glitch_meta*}]
set_false_path -from [get_clocks ov1_pclk] -to [get_cells -hierarchical {first_geometry_meta*}]

# Recovery consumes held capture-fault status through two synchronizer stages.
set_false_path -from [get_clocks ov1_pclk] -to [get_cells -hierarchical {recovery*fault_sync* recovery*ready_sync*}]
# The recovery reset is asynchronous assertion, with local synchronous release.
set_false_path -from [get_cells -hierarchical {recovery*state*}] -to [get_cells -hierarchical {capture_restart_p* capture_restart_r*}]

# Capture reset synchronizer receives original asynchronous core/GPIO/recovery
# conditions directly. Only its synchronizer reset inputs are excepted;
# PC-domain synchronous reset release to capture/FIFO flops remains timed.
set_false_path -from [get_clocks {ddrphy_sysclk sys_clk}] -to [get_cells -hierarchical {capture_restart_p*}]

# R9 passive source diagnostics: Gray counts/held frame snapshots, first stage only.
set_false_path -from [get_clocks ov1_pclk] -to [get_cells -hierarchical {raw_diag_meta*}]
# R10 independent hardware divided-clock reference; only passive diagnostic CDC.
create_generated_clock -name ov1_halfclk -source [get_ports ov1_pclk] -divide_by 2 [get_pins camera_clock_divider/CLKDIVOUT]
set_max_delay -datapath_only 5.952 -from [get_cells -hierarchical {clock_probe*gray*}] -to [get_cells -hierarchical {clock_probe*meta*}]
set_false_path -from [get_clocks {sys_clk ddrphy_sysclk}] -to [get_cells -hierarchical {clock_probe_release*}]
set_false_path -from [get_clocks {sys_clk ddrphy_sysclk}] -to [get_pins camera_clock_divider/RST_N]



# R13 network pins: original 100Pro+ image project.
