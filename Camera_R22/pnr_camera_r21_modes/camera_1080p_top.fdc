create_clock -name rgmii_rxc -period 8.000 [get_ports rgmii_rxc]
create_generated_clock -name net_clk -source [get_ports rgmii_rxc] -multiply_by 1 -divide_by 1 [get_pins net.ref_clock/clkout0]
set_clock_groups -name net_async -asynchronous -group [get_clocks {rgmii_rxc net_clk}]
set_false_path -from [get_clocks sys_clk] -to [get_cells -hierarchical {net.nr*}]

# R17 RAW RGB/control coherent FIFO: only Gray pointer CDC paths are bounded.
set_max_delay -datapath_only 8.000 -from [get_cells -hierarchical {raw_rgb_cdc*wg*}] -to [get_cells -hierarchical {raw_rgb_cdc*ws1*}]
set_max_delay -datapath_only 8.000 -from [get_cells -hierarchical {raw_rgb_cdc*rg*}] -to [get_cells -hierarchical {raw_rgb_cdc*rs1*}]
set_false_path -from [get_cells -hierarchical {raw_cdc_overflow*}] -to [get_cells -hierarchical {raw_overflow_meta*}]

# R22 EIS: WT901 TTL TX -> ATK J1-7 / LA18_P_CC, pin U22, common GND.
define_attribute {p:imu_rx} PAP_IO_DIRECTION {INPUT}
define_attribute {p:imu_rx} PAP_IO_LOC {U22}
define_attribute {p:imu_rx} PAP_IO_VCCIO {3.3}
define_attribute {p:imu_rx} PAP_IO_STANDARD {LVCMOS33}
define_attribute {p:imu_rx} PAP_IO_NONE {TRUE}
set_false_path -from [get_ports imu_rx] -to [get_cells -hierarchical {serial_control*iu*sync*}]
# One-microsecond Gray counter: source to first synchronizer stage only.
set_max_delay 37.037 -datapath_only -from [get_cells -hierarchical {serial_control*clock_us_gray*}] -to [get_cells -hierarchical {eis_time_meta*}]
